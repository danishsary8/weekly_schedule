APP_NAME="Daycraft"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-daycraft-api.onrender.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Render injects its managed PostgreSQL internal connection string here.
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Resend uses HTTPS rather than SMTP, which Render's free web tier blocks.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=hello@your-verified-domain.example
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
DIAGNOSTIC_TOKEN=

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.05

ANALYTICS_ENABLED=true
ANALYTICS_ADMIN_EMAILS=owner@example.com

FRONTEND_URL=https://your-daycraft-project.vercel.app
CORS_ALLOWED_ORIGINS=https://your-daycraft-project.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-daycraft-project.vercel.app
SANCTUM_TOKEN_EXPIRATION=43200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-daycraft-api.onrender.com/api/v1/auth/google/callback

ALADHAN_BASE_URL=https://api.aladhan.com/v1
ALADHAN_METHOD=2
ALADHAN_TIMEOUT=8
PRAYER_DEFAULT_LATITUDE=11.5564
PRAYER_DEFAULT_LONGITUDE=104.9282
